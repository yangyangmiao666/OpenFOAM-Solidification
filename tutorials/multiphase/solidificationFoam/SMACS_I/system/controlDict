FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     solidificationFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

// Full SMACS_I physics target is 600 s. Bring-up / CI uses a short window.
// Set endTime 600 for production runs.
endTime         0.05;

deltaT          0.005;

writeControl    adjustableRunTime;

writeInterval   0.05;

purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  no;

functions
{
    #includeFunc residuals
}


FoamFile
{
    format      ascii;
    class       volScalarField;
    object      C;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.18;

boundaryField
{
    "(bottom|top|right)"
    {
        type            zeroGradient;
    }
    
    left     
    {
        type            symmetryPlane;
    }
}

